# --- Core ---
PORT=8000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# Comma-separated browser origins allowed to send credentials (production: your real site URL(s))
CORS_ORIGIN=http://localhost:5173

# Behind nginx / load balancer: set so req.ip and secure cookies work
# TRUST_PROXY=true

# Public API URL for verification links in emails (no trailing slash). Use your deployed API hostname in production.
VERIFY_EMAIL_BASE_URL=http://localhost:8000

# JWT — use long random strings (openssl rand -hex 32). In production, validateEnv requires length >= 32.
ACCESS_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32-chars-minimum
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32-chars-minimum
REFRESH_TOKEN_EXPIRY=10d

# HttpOnly cookies — default sameSite=lax (same registrable domain as API). For API on another subdomain with SPA, use:
# COOKIE_SAME_SITE=none
# (requires HTTPS in production; secure is set automatically for sameSite=none)

FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# Rate limits (optional overrides)
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_REFRESH_MAX=60

# --- Email: production SMTP (optional: SendGrid, SES, Mailgun, etc.) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Job Portal <noreply@yourdomain.com>"
# MAIL_PRODUCT_NAME=Job Portal
# MAIL_PRODUCT_URL=https://yourdomain.com

# --- Email: default transport (Gmail App Password) ---
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# MAIL_FROM="Job Portal <your-email@gmail.com>"
