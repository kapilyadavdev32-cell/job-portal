# Copy to .env. Vite reads this at dev/build time.
#
# Local dev with proxy (recommended): keep this so requests go to the Vite dev server,
# which forwards /api → http://localhost:8000 (see vite.config.js).
VITE_API_BASE_URL=/api/v1

# Alternative: call the backend directly (same machine). Ensure CORS_ORIGIN on the server includes http://localhost:5173.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
