# Build-time: URL of the API (must match CORS_ORIGIN on the server). No trailing slash.
# Example when frontend and API share one origin behind nginx: VITE_API_BASE_URL=/api/v1
# Example when API is on another host: VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=https://api.example.com/api/v1
